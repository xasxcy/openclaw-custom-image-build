OPENCLAW_IMAGE=ghcr.io/xasxcy/openclaw:latest

# 用于 gateway 和 CLI 之间的认证，生成方式：openssl rand -hex 32
OPENCLAW_GATEWAY_TOKEN=<your-secure-token>
OPENCLAW_CONFIG_DIR=./config
OPENCLAW_WORKSPACE_DIR=./workspace
OPENCLAW_WORKSPACE_DIR_MIKA=./workspace-mika

OPENCLAW_TZ=Asia/Shanghai
OPENCLAW_GATEWAY_BIND=lan
OPENCLAW_GATEWAY_PORT=18789
OPENCLAW_BRIDGE_PORT=18790
OPENCLAW_ALLOW_INSECURE_PRIVATE_WS=
OPENCLAW_DISABLE_BONJOUR=

# Channels（配置优先，环境变量回退）
TELEGRAM_BOT_TOKEN=<your-telegram-bot-token>
DISCORD_BOT_TOKEN=<your-discord-bot-token>
GOG_KEYRING_PASSWORD=<your-keyring-password>

# Claude Web
CLAUDE_AI_SESSION_KEY=
CLAUDE_WEB_SESSION_KEY=
CLAUDE_WEB_COOKIE=

# OpenTelemetry
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=
OTEL_EXPORTER_OTLP_METRICS_ENDPOINT=
OTEL_EXPORTER_OTLP_LOGS_ENDPOINT=
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_SERVICE_NAME=
OTEL_SEMCONV_STABILITY_OPT_IN=
OPENCLAW_OTEL_PRELOADED=

# API Keys
BRAVE_API_KEY=<your-brave-api-key>
GEMINI_API_KEY=<your-gemini-api-key>

# home 持久化
OPENCLAW_HOME_VOLUME=openclaw_home
XDG_CONFIG_HOME=/home/node/.openclaw

# Google Vertex AI
GOOGLE_CLOUD_PROJECT=<your-gcp-project-id>
GOOGLE_CLOUD_LOCATION=global
# GOOGLE_APPLICATION_CREDENTIALS=/root/.config/gcloud/application_default_credentials.json

# 代理（可选，留空则不走代理）
# HTTP_PROXY=http://192.168.x.x:8888
# HTTPS_PROXY=http://192.168.x.x:8888
